<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- 제목 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FrameLayout 실습"
        android:textColor="#8BC34A"
        android:textSize="18sp"
        android:textStyle="bold|italic" />

    <!-- 가운데 영역: 왼쪽(캐릭터+소품) / 오른쪽(드레스 3개) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 왼쪽 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- ★ 캐릭터: 프레임 레이아웃으로 겹치기 (나중에 넣은 것이 위에 표시됨) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <!-- 1) 몸 -->
                <ImageView
                    android:id="@+id/imageViewBody"
                    android:layout_width="159dp"
                    android:layout_height="274dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/body" />

                <!-- 2) 드레스 (몸 위에) -->
                <ImageView
                    android:id="@+id/imageViewObjDress"
                    android:layout_width="156dp"
                    android:layout_height="173dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="120dp"
                    android:src="@drawable/dress1" />

                <!-- 3) 목걸이 (드레스 위에) -->
                <ImageView
                    android:id="@+id/imageViewObjNecklace"
                    android:layout_width="156dp"
                    android:layout_height="33dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="122dp"
                    android:translationZ="1dp"
                    android:src="@drawable/necklace1" />

                <!-- 4) 왕관 (맨 위) -->
                <ImageView
                    android:translationZ="2dp"
                    android:id="@+id/imageViewObjCrown"
                    android:layout_width="156dp"
                    android:layout_height="33dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/crown2" />
            </FrameLayout>

            <!-- 왕관 선택 줄 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageViewCrown1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:src="@drawable/crown1" />

                <ImageView
                    android:id="@+id/imageViewCrown2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:src="@drawable/crown2" />
            </LinearLayout>

            <!-- 목걸이 선택 줄 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageViewNecklace1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:src="@drawable/necklace1" />

                <ImageView
                    android:id="@+id/imageViewNecklace2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="onClickChoice"
                    android:src="@drawable/necklace2" />
            </LinearLayout>
        </LinearLayout>

        <!-- 오른쪽: 드레스 3개 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageViewDress1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="onClickChoice"
                android:src="@drawable/dress1" />

            <ImageView
                android:id="@+id/imageViewDress2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="onClickChoice"
                android:src="@drawable/dress2" />

            <ImageView
                android:id="@+id/imageViewDress3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="onClickChoice"
                android:src="@drawable/dress3" />
        </LinearLayout>
    </LinearLayout>

    <!-- 다시하기 -->
    <Button
        android:id="@+id/buttonReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="onClickChoice"
        android:text="다시하기" />

</LinearLayout>