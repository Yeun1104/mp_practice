<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ⋮ 안에 들어가는 메뉴 -->
    <item
        android:id="@+id/menu_init"
        android:title="초기화" />

    <!-- 앱 바에 항상 보이는 액션 아이템 (모양은 actionLayout 레이아웃) -->
    <item
        android:id="@+id/menu_up"
        android:icon="@drawable/thumbs_up"
        android:title="찬성"
        app:actionLayout="@layout/ok_layout"
        app:showAsAction="always" />
    <item
        android:id="@+id/menu_down"
        android:icon="@drawable/thumbs_down"
        android:title="반대"
        app:actionLayout="@layout/no_layout"
        app:showAsAction="always" />

    <!-- ⋮ 안에 들어가는 메뉴 -->
    <item
        android:id="@+id/menu_close"
        android:title="종료" />
</menu>