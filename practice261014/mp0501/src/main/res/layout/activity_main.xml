<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ButtonEvent 실습"
        android:textColor="#8BC34A"
        android:textSize="18sp"
        android:textStyle="bold|italic" />

    <!-- 문제 그림: 달팽이 위에 선택한 껍데기를 겹침 -->
    <FrameLayout
        android:layout_width="326dp"
        android:layout_height="261dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp">

        <ImageView
            android:id="@+id/imageViewQuestion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/question" />

        <!-- 선택한 껍데기 (처음엔 숨김) -->
        <ImageView
            android:id="@+id/imageViewAnswer"
            android:layout_width="246dp"
            android:layout_height="199dp"
            android:layout_marginStart="72dp"
            android:layout_marginTop="8dp"
            android:visibility="invisible"
            android:src="@drawable/answer2" />
    </FrameLayout>

    <!-- 보기 4개 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1" />
            <ImageButton
                android:id="@+id/imageButton1"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@null"
                android:contentDescription="1번"
                android:scaleType="fitCenter"
                android:src="@drawable/answer1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="2" />
            <ImageButton
                android:id="@+id/imageButton2"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@null"
                android:contentDescription="2번"
                android:scaleType="fitCenter"
                android:src="@drawable/answer2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="3" />
            <ImageButton
                android:id="@+id/imageButton3"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@null"
                android:contentDescription="3번"
                android:scaleType="fitCenter"
                android:src="@drawable/answer3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="4" />
            <ImageButton
                android:id="@+id/imageButton4"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@null"
                android:contentDescription="4번"
                android:scaleType="fitCenter"
                android:src="@drawable/answer4" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>