<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ToggleButton 실습"
        android:textColor="#8BC34A"
        android:textSize="18sp"
        android:textStyle="bold|italic" />

    <!-- 방 장면: 배경 위에 조명 3개와 벽 스위치를 겹침 -->
    <FrameLayout
        android:layout_width="320dp"
        android:layout_height="286dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp">

        <!-- 배경 -->
        <ImageView
            android:id="@+id/imageViewBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/bg1" />

        <!-- 조명 1 (왼쪽) -->
        <ImageView
            android:id="@+id/imageViewLight1"
            android:layout_width="43dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="115dp"
            android:adjustViewBounds="true"
            android:src="@drawable/light11" />

        <!-- 조명 2 (가운데) -->
        <ImageView
            android:id="@+id/imageViewLight2"
            android:layout_width="43dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="158dp"
            android:adjustViewBounds="true"
            android:src="@drawable/light12" />

        <!-- 조명 3 (오른쪽) -->
        <ImageView
            android:id="@+id/imageViewLight3"
            android:layout_width="43dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="200dp"
            android:adjustViewBounds="true"
            android:src="@drawable/light13" />

        <!-- 벽 스위치 = 토글 버튼 (글자 없이 그림만) -->
        <ToggleButton
            android:id="@+id/toggleButton"
            android:layout_width="30dp"
            android:layout_height="42dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="273dp"
            android:layout_marginTop="93dp"
            android:background="@drawable/off"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:textOff=""
            android:textOn="" />
    </FrameLayout>

</LinearLayout>