<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="20dp"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="SharedPreferences 실습"
        android:textColor="#8BC34A"
        android:textSize="25sp"
        android:textStyle="bold|italic" />

    <!-- 고양이 그림 위에 "A x B" 문제를 겹침 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imageView_bg"
            android:layout_width="195dp"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/bg_quiz" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="30dp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/imageView_num1"
                android:layout_width="40dp"
                android:layout_height="50dp"
                app:srcCompat="@drawable/num1" />
            <ImageView
                android:id="@+id/imageView_op"
                android:layout_width="40dp"
                android:layout_height="50dp"
                app:srcCompat="@drawable/op1" />
            <ImageView
                android:id="@+id/imageView_num2"
                android:layout_width="40dp"
                android:layout_height="50dp"
                app:srcCompat="@drawable/num2" />
        </LinearLayout>
    </FrameLayout>

    <EditText
        android:id="@+id/editText_answer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:hint="정답을 입력하세요"
        android:inputType="number" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/button_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:backgroundTint="#00ACC1"
            android:text="다시시작하기" />
        <Button
            android:id="@+id/button_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:backgroundTint="#00ACC1"
            android:text="정답확인하기" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="당신의 정답률은 0% 입니다"
        android:textColor="#D81B60" />

</LinearLayout>
